PORT=3244
NEXT_PUBLIC_APP_NAME="Focus: Forge"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
USE_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SITE_URL=http://localhost:3244
JWT_SECRET=
ACCOUNT_LINK_JWT_SECRET=

# TPC Auth (auth.theportlandcompany.com) is the sole identity provider for the
# web app — see lib/auth/tpc-session.ts. SUPABASE_JWT_SECRET signs the 5-min
# HS256 JWT that bridges a TPC viewer onto Supabase RLS (lib/auth/local-identity.ts);
# same value as the project's JWT secret (Supabase dashboard > Settings > API).
# TPC_AUTH_ISSUER only needs setting to point at a non-default TPC Auth issuer.
SUPABASE_JWT_SECRET=
TPC_AUTH_ISSUER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Focus: Forge"
TODOIST_API_TOKEN=

# AI model waterfall (estimator, assistant, email/spam triage). Each key is
# optional: a model whose provider key is missing is skipped, not an error.
# The email/spam surface defaults to `deepseek-v4-flash` — DeepSeek's current
# generation (V4) and its economical half, which suits per-message triage
# volume. `deepseek-v4-pro` is selectable in Settings, as is `deepseek-chat`
# (the legacy V3 alias). The V4 models are hybrid reasoners, so the runner
# always sends a max_tokens large enough for reasoning + the JSON answer.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Private, trainable spam detection. Embeddings via Cloudflare Workers AI
# (CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID); OpenAI 768-d fallback if unset.
# SPAM_FALLBACK_MODE=llm (OpenAI backstop) | private (k-NN + heuristics only).
SPAM_FALLBACK_MODE=llm
SPAM_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
SPAM_CONFIDENCE_THRESHOLD=0.72

# Free, self-hosted LLM fallback (Cloudflare Workers AI, model id
# cf-llama-3.3-70b) that sits at the END of every model chain, so email triage
# and the "AI Analyze" spam explanation keep working when the paid providers
# above are out of credits. Uses the same CLOUDFLARE_* creds as the embeddings.
# Override the underlying open model here if desired.
CF_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
