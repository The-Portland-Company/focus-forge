# Copy this file to .env and update with your values

# Application
PORT=3244
NEXT_PUBLIC_APP_NAME="Focus: Forge"
NODE_ENV=development

# Database Adapter Selection
# Set to 'true' to use Supabase, 'false' for file-based storage
USE_SUPABASE=true

# Supabase Configuration (required when USE_SUPABASE=true)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: Keep this secret! Never commit to git or expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-keep-this-secret

# JWT Secret for authentication 
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=generate-a-strong-secret-key-here

# File-based Database (when USE_SUPABASE=false)
DATABASE_PATH=./data/database.json

# Feature Flags
# Authentication requirement (mainly for mobile/iOS)
REQUIRE_AUTH=false

# Platform detection
IS_MOBILE=false

# Todoist Integration
TODOIST_API_TOKEN=your-todoist-api-token-here

# Private, trainable spam detection (k-NN over pgvector spam_signatures).
# Embeddings run on Cloudflare Workers AI (reuses CLOUDFLARE_API_TOKEN +
# CLOUDFLARE_ACCOUNT_ID); falls back to OpenAI (truncated to 768-d) if unset.
# SPAM_FALLBACK_MODE: "llm" (default) runs the multi-provider LLM backstop for
# low-confidence emails; "private" is the kill-switch that keeps everything
# local (k-NN + heuristics, no email content leaves the app).
SPAM_FALLBACK_MODE=llm
SPAM_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
SPAM_CONFIDENCE_THRESHOLD=0.72

# Email/spam triage waterfall. Each organization picks its own provider order in
# Settings → Email AI providers (organizations.ai_settings.email); the default is
# DeepSeek → Claude → Grok. A provider whose key is missing here is SKIPPED, and
# a quota/auth error falls through to the next — so it is safe to leave any of
# these unset. If every provider is unavailable, local heuristics take over.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here
OPENAI_API_KEY=your-openai-api-key-here